extends: default

ignore: |
  /.venv/
  /.tox/
  /build/
  /dist/

rules:
  document-start: disable
  line-length:
    max: 88
    ignore: |
      /.github/*.yml
      /.github/workflows/*.yml
  truthy:
    # on: ...
    ignore: |
      /.github/workflows/*.yml
  indentation:
    ignore: |
      /.github/workflows/*.yml
  comments-indentation:
    ignore: |
      /.github/workflows/*.yml
